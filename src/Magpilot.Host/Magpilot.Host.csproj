<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Magpilot.Host</RootNamespace>
    <AssemblyName>magpilot</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Native AOT: the launcher runs on every `magpilot` invocation, so
         its JIT warmup is pure per-invocation latency. AOT drops cold start
         to roughly a third and ships a single native magpilot.exe (no
         coreclr.dll / deps.json). All wire JSON goes through the
         source-generated HostWebJsonContext / HostGeneralJsonContext so the
         publish is reflection-free. Only engages on `dotnet publish`; plain
         `dotnet build` just runs the AOT analyzers. -->
    <PublishAot>true</PublishAot>
    <!-- Porta.Pty's Windows native assets are architecture-specific.
         x64 covers the supported launcher build; ARM64 would need a
         separate publish profile. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Magpilot.Shared\Magpilot.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Magpilot.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Porta.Pty" Version="2.2.2" />
  </ItemGroup>

</Project>
